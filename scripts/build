#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/environment.sh"
MOUSU_CONFIGURATION="${1:-debug}"
if [[ "$MOUSU_CONFIGURATION" != "debug" && "$MOUSU_CONFIGURATION" != "release" ]]; then
    echo "Usage: $0 [debug|release]" >&2
    exit 1
fi
"$MOUSU_SWIFT" build --sdk "$SDKROOT" --triple "$MOUSU_TRIPLE" -c "$MOUSU_CONFIGURATION"
