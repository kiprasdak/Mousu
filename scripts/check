#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/environment.sh"
"$MOUSU_SWIFT" format lint --strict --recursive Sources Package.swift scripts/*.swift
/usr/bin/plutil -lint Resources/Info.plist
python3 scripts/update-device-database.py --check
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git diff --check
fi
